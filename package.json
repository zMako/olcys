{
  "name": "olcys",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OŁCyŚ — Osintowy Łapacz Cyfrowych Śladów",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "world": "tsx packages/world/src/cli.ts serve",
    "world:generate": "tsx packages/world/src/cli.ts generate",
    "db:migrate": "tsx packages/db/src/migrate-cli.ts",
    "analyze": "tsx apps/api/src/cli.ts",
    "api": "tsx apps/api/src/server.ts",
    "web": "npm run dev -w @olcys/web",
    "web:build": "npm run build -w @olcys/web",
    "check:ui": "node scripts/live-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/pg": "^8.11.0",
    "playwright": "^1.65.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  }
}
