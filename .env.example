# PostgreSQL in production; pglite://<dir> (embedded Postgres) or pglite://memory for local runs
DATABASE_URL=pglite://./.data/pglite
# Synthetic "mini-internet" (three independent origins)
WORLD_FORUM_URL=http://localhost:4101
WORLD_CODE_URL=http://localhost:4102
WORLD_ADS_URL=http://localhost:4103
WORLD_EXPLORER_URL=http://localhost:4104
# Official NBP rates: offline copy by default; https://api.nbp.pl reads them live from the National Bank of Poland
NBP_API_URL=http://localhost:4105
PRICES_URL=http://localhost:4105
# Web archive with past versions of pages
ARCHIVE_URL=http://localhost:4106
# Comma-separated host[:port] list the engine may contact. Empty = hosts of the configured connectors only.
EGRESS_ALLOWLIST=
API_PORT=4000

# --- Live sources (the public internet). Chosen per analysis in the interface, or by default with SOURCES=live
SOURCES=synthetic
# GitHub allows 60 anonymous requests an hour per IP address; a token lifts that and enables searching code for an address
GITHUB_TOKEN=
# Any Esplora-compatible Bitcoin explorer, including one inside your own network
BITCOIN_API_URL=https://mempool.space/api
# Any Ethereum node (JSON-RPC), including your own
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# Indexer with a Blockscout-style API: transfer history and contract creators. Label service: which addresses are exchanges.
ETH_INDEXER_URL=https://eth.blockscout.com
ETH_LABELS_URL=https://metadata.services.blockscout.com

# Transfer history on the Base network (Alchemy, free plan; enable "Base Mainnet" for the app). Sent in a header, never stored.
ALCHEMY_KEY=
# A node of BNB Smart Chain: Binance marks verified customers' addresses there with a non-transferable token
BSC_RPC_URL=https://bsc-rpc.publicnode.com
# Public attestations about addresses (Ethereum Attestation Service on Base) and Base names
ATTESTATIONS_URL=https://base.easscan.org/graphql
BASE_RPC_URL=https://mainnet.base.org
# Language model served on this machine (Ollama). Any model behind the same API can be swapped in.
LLM_URL=http://localhost:11434
LLM_MODEL=SpeakLeash/bielik-11b-v3.1-instruct:Q8_0
# Who is acting, for the audit log (the interface may send it per request in the x-analyst header)
ANALYST=analityk
# Where the locally built register lives (never committed)
CORPUS_DIR=.corpus
